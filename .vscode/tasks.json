{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build",
      "type": "shell",
      "command": "cargo",
      "args": ["build"],
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "cargo run",
      "type": "shell",
      "command": "cargo",
      "args": ["run"],
      "problemMatcher": ["$rustc"],
      "options": {
        "env": {
          "RUST_BACKTRACE": "1",
          "TUCANO_DATA_DIR": "${workspaceFolder}/data"
        }
      }
    },
    {
      "label": "cargo test",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--all-targets"],
      "problemMatcher": ["$rustc"],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "cargo clippy",
      "type": "shell",
      "command": "cargo",
      "args": ["clippy", "--all-targets", "--", "-D", "warnings"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "cargo fmt",
      "type": "shell",
      "command": "cargo",
      "args": ["fmt", "--all"],
      "problemMatcher": []
    },
    {
      "label": "cargo fmt check",
      "type": "shell",
      "command": "cargo",
      "args": ["fmt", "--all", "--", "--check"],
      "problemMatcher": []
    },
    {
      "label": "gui: server (background)",
      "type": "shell",
      "command": "cargo",
      "args": ["run"],
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "custom",
          "pattern": [{ "regexp": "^$" }],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Compiling|Finished",
            "endsPattern": "listening on :"
          }
        }
      ],
      "options": {
        "env": {
          "RUST_BACKTRACE": "1",
          "TUCANO_DATA_DIR": "${workspaceFolder}/data"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "gui: open browser",
      "command": "${input:openDefaultBrowser}",
      "problemMatcher": []
    },
    {
      "label": "gui: run (server + browser)",
      "dependsOn": ["gui: server (background)", "gui: open browser"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openDefaultBrowser",
      "type": "command",
      "command": "vscode.open",
      "args": ["http://127.0.0.1:8080"]
    }
  ]
}