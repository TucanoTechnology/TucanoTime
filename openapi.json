{
  "openapi": "3.1.0",
  "info": {
    "title": "TucanoTime API",
    "version": "0.1.0",
    "license": { "name": "AGPL-3.0-or-later", "identifier": "AGPL-3.0-or-later" },
    "description": "Timesheet system: daily/weekly time entries, customers and project codes with per-entity currencies and hourly rates. File-backed (no database); the API is the only writer below TUCANO_DATA_DIR."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "cookieAuth": [] }],
  "tags": [
    { "name": "customers" },
    { "name": "projects" },
    { "name": "entries" },
    { "name": "reports" },
    { "name": "auth" },
    { "name": "users" },
    { "name": "invoices" },
    { "name": "meta" }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "tt_session",
        "description": "HttpOnly session cookie issued by /auth/login or /auth/bootstrap."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string", "enum": ["validation_failed", "not_found", "conflict", "bad_request", "internal", "invalid_json"] },
              "message": { "type": "string", "description": "Human-readable; never contains paths, stack traces or raw filesystem errors." },
              "fields": {
                "type": "array",
                "description": "Per-field problems for validation_failed.",
                "items": { "$ref": "#/components/schemas/FieldError" }
              }
            }
          }
        }
      },
      "FieldError": {
        "type": "object",
        "required": ["field", "message"],
        "properties": {
          "field": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "Currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "description": "ISO-4217 alpha-3 code, upper case.",
        "examples": ["EUR", "USD"]
      },
      "ProjectCode": {
        "type": "string",
        "pattern": "^[A-Z0-9][A-Z0-9_-]{0,23}$",
        "description": "Normalised upper case; letters and digits, dashes and underscores after the first character; at most 24 characters.",
        "examples": ["ACME-42"]
      },
      "Hours": {
        "type": "number",
        "minimum": 0.01,
        "maximum": 24,
        "description": "Hours as a decimal with at most two fractional digits (0.01–24.00). Stored as integer hundredths.",
        "examples": [7.5]
      },
      "RateMinor": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100000000,
        "description": "Hourly rate in currency minor units (cents). 6000 = 60.00.",
        "examples": [6000]
      },
      "Customer": {
        "type": "object",
        "required": ["id", "name", "currency", "default_rate_minor", "active"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "currency": { "$ref": "#/components/schemas/Currency" },
          "default_rate_minor": { "$ref": "#/components/schemas/RateMinor" },
          "active": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "CustomerInput": {
        "type": "object",
        "required": ["name", "currency", "default_rate_minor"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "currency": { "$ref": "#/components/schemas/Currency" },
          "default_rate_minor": { "$ref": "#/components/schemas/RateMinor" },
          "active": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      },
      "Project": {
        "type": "object",
        "required": ["customer_id", "code", "name", "currency", "rate_minor", "active"],
        "properties": {
          "customer_id": { "type": "string", "format": "uuid" },
          "code": { "$ref": "#/components/schemas/ProjectCode" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "currency": { "$ref": "#/components/schemas/Currency" },
          "rate_minor": { "$ref": "#/components/schemas/RateMinor" },
          "active": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "ProjectInput": {
        "type": "object",
        "required": ["code", "currency", "rate_minor"],
        "properties": {
          "code": { "$ref": "#/components/schemas/ProjectCode" },
          "name": { "type": "string", "maxLength": 120, "default": "" },
          "currency": { "$ref": "#/components/schemas/Currency" },
          "rate_minor": { "$ref": "#/components/schemas/RateMinor" },
          "active": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      },
      "Task": {
        "type": "object",
        "required": ["customer_id", "project_code", "code", "name", "active"],
        "properties": {
          "customer_id": { "type": "string", "format": "uuid" },
          "project_code": { "$ref": "#/components/schemas/ProjectCode" },
          "code": { "$ref": "#/components/schemas/ProjectCode" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "currency": { "$ref": "#/components/schemas/Currency" },
          "rate_minor": { "$ref": "#/components/schemas/RateMinor" },
          "active": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "TaskInput": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "$ref": "#/components/schemas/ProjectCode" },
          "name": { "type": "string", "maxLength": 120, "default": "" },
          "currency": { "$ref": "#/components/schemas/Currency" },
          "rate_minor": { "$ref": "#/components/schemas/RateMinor" },
          "active": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      },
      "Entry": {
        "type": "object",
        "required": ["id", "date", "customer_id", "project_code", "hours", "note", "billable", "source", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "customer_id": { "type": "string", "format": "uuid" },
          "user_id": { "oneOf": [ { "type": "string", "format": "uuid" }, { "type": "null" } ], "description": "The user who logged the entry (attribution, #21)." },
          "project_code": { "$ref": "#/components/schemas/ProjectCode" },
          "task_code": { "oneOf": [ { "$ref": "#/components/schemas/ProjectCode" }, { "type": "null" } ], "description": "Optional task within the project (#38)." },
          "hours": { "$ref": "#/components/schemas/Hours" },
          "note": { "type": "string", "maxLength": 500 },
          "billable": { "type": "boolean", "description": "Billable vs non-billable time. Non-billable time is never invoiced." },
          "source": { "type": "string", "enum": ["manual", "timer", "calendar-import"], "description": "Provenance. Server-set; API clients create manual entries." },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      },
      "EntryInput": {
        "type": "object",
        "required": ["date", "customer_id", "project_code", "hours"],
        "properties": {
          "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "customer_id": { "type": "string", "format": "uuid" },
          "project_code": { "$ref": "#/components/schemas/ProjectCode" },
          "task_code": { "oneOf": [ { "$ref": "#/components/schemas/ProjectCode" }, { "type": "null" } ] },
          "hours": { "$ref": "#/components/schemas/Hours" },
          "note": { "type": "string", "maxLength": 500, "default": "" },
          "billable": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      },
      "SummaryRow": {
        "type": "object",
        "required": ["key", "label", "currency", "hours", "amount_minor", "entries"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "currency": { "$ref": "#/components/schemas/Currency" },
          "hours": { "type": "number" },
          "amount_minor": { "type": "integer", "minimum": 0 },
          "entries": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      },
      "Summary": {
        "type": "object",
        "required": ["group", "rows", "total_hours"],
        "properties": {
          "group": { "type": "string", "enum": ["customer", "project", "week"] },
          "rows": { "type": "array", "items": { "$ref": "#/components/schemas/SummaryRow" } },
          "total_hours": { "type": "number" }
        },
        "additionalProperties": false
      },
      "PublicUser": {
        "type": "object",
        "required": ["id", "name", "email", "role", "active", "default_rate_minor"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["admin", "member"] },
          "active": { "type": "boolean" },
          "default_rate_minor": { "$ref": "#/components/schemas/RateMinor" }
        },
        "additionalProperties": false
      },
      "LoginInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        },
        "additionalProperties": false
      },
      "BootstrapInput": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8 }
        },
        "additionalProperties": false
      },
      "UserInput": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8 },
          "role": { "type": "string", "enum": ["admin", "member"] },
          "active": { "type": "boolean", "default": true },
          "default_rate_minor": { "$ref": "#/components/schemas/RateMinor" }
        },
        "additionalProperties": false
      },
      "InvoiceStatus": { "type": "string", "enum": ["draft", "issued", "paid"] },
      "InvoiceLine": {
        "type": "object",
        "required": ["entry_id", "date", "project_code", "hours", "rate_minor", "amount_minor", "note"],
        "properties": {
          "entry_id": { "type": "string", "format": "uuid" },
          "date": { "type": "string", "format": "date" },
          "project_code": { "$ref": "#/components/schemas/ProjectCode" },
          "task_code": { "oneOf": [ { "$ref": "#/components/schemas/ProjectCode" }, { "type": "null" } ] },
          "hours": { "$ref": "#/components/schemas/Hours" },
          "rate_minor": { "$ref": "#/components/schemas/RateMinor" },
          "amount_minor": { "type": "integer", "minimum": 0 },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      },
      "Invoice": {
        "type": "object",
        "required": ["id", "number", "customer_id", "currency", "period_from", "period_to", "lines", "total_minor", "status", "created_at"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "number": { "type": "string" },
          "customer_id": { "type": "string", "format": "uuid" },
          "currency": { "$ref": "#/components/schemas/Currency" },
          "period_from": { "type": "string", "format": "date" },
          "period_to": { "type": "string", "format": "date" },
          "lines": { "type": "array", "items": { "$ref": "#/components/schemas/InvoiceLine" } },
          "total_minor": { "type": "integer", "minimum": 0 },
          "status": { "$ref": "#/components/schemas/InvoiceStatus" },
          "created_at": { "type": "string", "format": "date-time" },
          "issued_at": { "type": [ "string", "null" ], "format": "date-time" }
        },
        "additionalProperties": false
      },
      "InvoiceInput": {
        "type": "object",
        "required": ["customer_id", "from", "to"],
        "properties": {
          "customer_id": { "type": "string", "format": "uuid" },
          "from": { "type": "string", "format": "date" },
          "to": { "type": "string", "format": "date" }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "ValidationError": {        "description": "Payload failed validation before any write or side effect.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "The resource does not exist.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Conflict": {
        "description": "The operation conflicts with existing state (duplicate, or referenced by entries).",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "BadRequest": {
        "description": "Malformed query or body.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "parameters": {
      "DateParam": {
        "name": "date",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "description": "Single day, YYYY-MM-DD. Exactly one of date or from+to."
      },
      "FromParam": {
        "name": "from",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "description": "Inclusive start of a range. Requires to; at most 400 days."
      },
      "ToParam": {
        "name": "to",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "description": "Inclusive end of a range."
      }
    }
  },
  "paths": {
    "/auth/status": {
      "get": {
        "operationId": "authStatus",
        "tags": ["auth"],
        "summary": "Whether an administrator exists yet (drives first-run setup)",
        "security": [],
        "responses": {
          "200": {
            "description": "Initialisation state.",
            "content": { "application/json": { "schema": { "type": "object", "required": ["initialised"], "properties": { "initialised": { "type": "boolean" } }, "additionalProperties": false } } }
          }
        }
      }
    },
    "/auth/bootstrap": {
      "post": {
        "operationId": "bootstrap",
        "tags": ["auth"],
        "summary": "Create the first administrator (only while no users exist)",
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BootstrapInput" } } } },
        "responses": {
          "201": { "description": "Admin created; session cookie set.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicUser" } } } },
          "403": { "description": "Already initialised." },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "tags": ["auth"],
        "summary": "Authenticate and receive a session cookie",
        "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginInput" } } } },
        "responses": {
          "200": { "description": "Authenticated; session cookie set.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicUser" } } } },
          "401": { "description": "Invalid credentials." }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "tags": ["auth"],
        "summary": "Clear the session cookie",
        "security": [],
        "responses": { "204": { "description": "Logged out." } }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "me",
        "tags": ["auth"],
        "summary": "The current authenticated user",
        "responses": {
          "200": { "description": "Current user.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicUser" } } } },
          "401": { "description": "Not authenticated." }
        }
      }
    },
    "/users": {
      "get": {
        "operationId": "listUsers",
        "tags": ["users"],
        "summary": "List users (admin only)",
        "responses": {
          "200": { "description": "All users.", "content": { "application/json": { "schema": { "type": "object", "required": ["users"], "properties": { "users": { "type": "array", "items": { "$ref": "#/components/schemas/PublicUser" } } }, "additionalProperties": false } } } },
          "403": { "description": "Admin role required." }
        }
      },
      "post": {
        "operationId": "createUser",
        "tags": ["users"],
        "summary": "Create a user (admin only)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserInput" } } } },
        "responses": {
          "201": { "description": "Created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PublicUser" } } } },
          "403": { "description": "Admin role required." },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/users/{id}": {
      "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } ],
      "delete": {
        "operationId": "deleteUser",
        "tags": ["users"],
        "summary": "Delete a user (admin only)",
        "responses": {
          "204": { "description": "Deleted." },
          "403": { "description": "Admin role required." },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "tags": ["meta"],
        "summary": "Liveness",
        "security": [],
        "responses": {
          "200": {
            "description": "Server is up.",
            "content": { "application/json": { "schema": { "type": "object", "properties": { "status": { "type": "string" } }, "required": ["status"], "additionalProperties": false } } }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openapi",
        "tags": ["meta"],
        "summary": "This machine-readable contract",
        "security": [],
        "responses": { "200": { "description": "The OpenAPI document.", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/docs": {
      "get": {
        "operationId": "docs",
        "tags": ["meta"],
        "summary": "Interactive documentation UI (Swagger), rendered from /openapi.json",
        "security": [],
        "responses": { "200": { "description": "HTML page.", "content": { "text/html": { "schema": { "type": "string" } } } } }
      }
    },
    "/customers": {
      "get": {
        "operationId": "listCustomers",
        "tags": ["customers"],
        "summary": "List customers, sorted by name",
        "responses": {
          "200": {
            "description": "All customers.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["customers"],
                  "properties": { "customers": { "type": "array", "items": { "$ref": "#/components/schemas/Customer" } } },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createCustomer",
        "tags": ["customers"],
        "summary": "Create a customer",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerInput" } } }
        },
        "responses": {
          "201": {
            "description": "Created; server assigns the id.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Customer" } } }
          },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/customers/{id}": {
      "parameters": [ { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } ],
      "get": {
        "operationId": "getCustomer",
        "tags": ["customers"],
        "summary": "Fetch one customer",
        "responses": {
          "200": { "description": "The customer.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Customer" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "operationId": "updateCustomer",
        "tags": ["customers"],
        "summary": "Full replacement of a customer (id stays fixed)",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CustomerInput" } } }
        },
        "responses": {
          "200": { "description": "The updated customer.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Customer" } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      },
      "delete": {
        "operationId": "deleteCustomer",
        "tags": ["customers"],
        "summary": "Delete a customer (must own no projects or entries)",
        "responses": {
          "204": { "description": "Deleted." },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/customers/{cid}/projects": {
      "parameters": [ { "name": "cid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } ],
      "get": {
        "operationId": "listProjects",
        "tags": ["projects"],
        "summary": "List a customer's projects, sorted by code",
        "responses": {
          "200": {
            "description": "Projects of this customer.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["projects"],
                  "properties": { "projects": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } } },
                  "additionalProperties": false
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "operationId": "createProject",
        "tags": ["projects"],
        "summary": "Add a project code to a customer",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProjectInput" } } }
        },
        "responses": {
          "201": { "description": "Created.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } } },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/customers/{cid}/projects/{code}": {
      "parameters": [
        { "name": "cid", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
        { "name": "code", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/ProjectCode" } }
      ],
      "get": {
        "operationId": "getProject",
        "tags": ["projects"],
        "summary": "Fetch one project",
        "responses": {
          "200": { "description": "The project.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Project" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "operationId": "updateProject",
        "tags": ["projects"],
        "summary": "Full replacement; body code must match the path code",
